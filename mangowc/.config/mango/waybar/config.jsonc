// -*- mode: jsonc -*-
{
    "height": 28,
    "spacing": 4,

    "include": ["~/.config/mango/waybar/modules.json"],

    "modules-left": [
        "dwl/tags",
        "custom/separator",
        "cpu",
        "memory",
        "battery", 
        "custom/separator",
        "dwl/window"
    ],

    "modules-center": [
        "custom/track"
    ],

    "modules-right": [
        "dwl/language",
        "custom/separator",
        "pulseaudio",
        "wireplumber",
        "custom/separator",
        "network",
        "custom/separator",
        "clock",
        "custom/separator",
        "tray"
    ]
}
